# =============================================================================
# Default sdkconfig for M5Tab5-VideoLink (ESP32-P4).
# PlatformIO applies these on first configure. Component-specific options are
# added as the corresponding subsystems are integrated.
# =============================================================================

# --- Chip revision ---
# The M5Stack Tab5 ships with pre-rev3.0 "ES" (engineering sample) ESP32-P4
# silicon. Revisions <3.0 and >=3.0 have very different memory layouts and are
# mutually exclusive in IDF, so we explicitly target the <3.0 layout. (If you
# have a newer rev3.x unit, remove these two lines to use the production layout.)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

# --- Flash (16 MB on the Tab5) ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# --- External SPI RAM (32 MB on the Tab5) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# --- FreeRTOS / main task ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Compiler ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# =============================================================================
# WiFi via the on-board ESP32-C6 co-processor (ESP-Hosted + esp_wifi_remote).
# =============================================================================
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y

# The Tab5 does NOT use the ESP32-P4-Function-EV-Board SDIO pin mapping. It
# wires the C6 on SDIO slot 1 (flexible GPIO matrix) with these pins, and uses
# an active-high reset on GPIO15. (Source: Tab5 schematic / esp-hosted-mcu#127.)
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y

# --- Throughput tuning for two simultaneous media streams over the link ---
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=32
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
